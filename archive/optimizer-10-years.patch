+  const back = paramsFromSettings({ ...DEFAULT_RULES, ...settingsPatch({ ...p, timeExitDays: 10, minTurnoverCr: 25, sizing: 'risk', climax: false }, DEFAULT_RULES).rules }, 'pause');
+  assert.equal(back.timeExitDays, 10);
